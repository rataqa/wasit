{
  "name": "@rataqa/wasit",
  "version": "1.0.4",
  "description": "Common Express.js middleware",
  "type": "commonjs",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "build:ts": "tsc --project tsconfig.build.json",
    "build:ts:test": "tsc --project tsconfig.json",
    "build": "npm-run-all clean build:ts",
    "build:test": "npm-run-all clean build:ts:test",
    "test": "node -r ts-node/register --test src/__tests__/*.test.ts",
    "test:coverage": "node -r ts-node/register --experimental-test-coverage --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@rataqa/sijil": "^1.0.3",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "request-ip": "^3.3.0",
    "response-time": "^2.3.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/connect-timeout": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/request-ip": "^0.0.41",
    "@types/response-time": "^2.3.9",
    "dotenv": "^17.3.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/rataqa/wasit#readme",
  "bugs": {
    "url": "https://github.com/rataqa/wasit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rataqa/wasit.git"
  },
  "license": "MIT",
  "author": "Rataqa Team",
  "keywords": [
    "worker",
    "amqp",
    "broker",
    "message",
    "queue"
  ]
}
